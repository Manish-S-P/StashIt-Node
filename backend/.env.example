# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=4000

# MongoDB. Locally this is the container from docker-compose.yml.
# In production, use your MongoDB Atlas connection string.
MONGO_URL=mongodb://localhost:27017/stashit

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Secret used to sign stash tokens. At least 32 random characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# S3-compatible storage. Locally: RustFS from docker-compose.yml.
# In production (Cloudflare R2):
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=stashit-dev
S3_SECRET_ACCESS_KEY=stashit-dev-secret
S3_BUCKET=stashit-dev

# Number of reverse proxies in front of the API (0 locally, 1 on Render).
# Needed so rate limiting sees the real client IP.
TRUST_PROXY=0

# Limits
MAX_STASH_MB=100
MAX_FILES_PER_STASH=20

# Requests allowed per IP address every 15 minutes
RATE_LIMIT_API=600
RATE_LIMIT_AUTH=30
